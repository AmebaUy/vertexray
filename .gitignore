# WordPress Core - NO VERSIONAR
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/index.php
/wp-load.php
/wp-blog-header.php
/wp-config-sample.php
/wp-comments-post.php
/wp-cron.php
/wp-links-opml.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/wp-activate.php

# wp-config.php (contiene credenciales sensibles)
/wp-config.php

# wp-content - Contenido de Usuario y Uploads
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/backups/
/wp-content/cache/
/wp-content/updraft/
/wp-content/ai1wm-backups/
/wp-content/wflogs/

# wp-content - Plugins y Temas de Terceros
/wp-content/plugins/
/wp-content/themes/engitech/
/wp-content/themes/twentytwenty*/

# EXCEPCIONES: Versionar child theme y plugins propios
!/wp-content/themes/engitech-child/
!/wp-content/plugins/ameba-*/

# wp-content - Archivos generados
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/db.php
/wp-content/*.sql
/wp-content/*.log

# Assets estáticos de la raíz (landing pages antiguas, etc)
/css/
/js/
/images/
/assets/
/fonts/
/*.html
/*.htm
/apple-touch-icon*.png
/favicon.ico

# EXCEPCIÓN: index.php custom si existe
!/index.php

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Node modules
node_modules/
package-lock.json

# Logs
*.log
error_log
debug.log

# Archivos temporales y backups
*.bak
*.tmp
*.orig
*.backup
*~

# Configuración local de ameba-deploy
/ameba-deploy-local-config/
.ameba-deploy.*.env
.ameba-deploy.state.env

# IMPORTANTE: LO QUE SÍ VERSIONAMOS
# - /ameba-deploy/ (scripts de deploy)
# - /ameba-maintenance/ (documentación y reportes)
# - /wp-content/themes/engitech-child/ (tema hijo)
# - Scripts de testing y automatización en la raíz
#
# Fact: you don't want WordPress core files, or your server-specific
# configuration files etc., in your project's repository. You just don't.
#
# Solution: stick this file up your repository root (which it assumes is
# also the WordPress root directory) and add exceptions for any plugins,
# themes, and other directories that should be under version control.
#
# See the comments below for more info on how to add exceptions for your
# content. Or see git's documentation for more info on .gitignore files:
# http://kernel.org/pub/software/scm/git/docs/gitignore.html

#ignore pipeline config
bitbucket-pipelines.yml

# Ignore everything in the root except the "wp-content" directory.

/index.php
/wp-cron.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-links-opml.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php
/wp-config.php
/wp-config-sample.php
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/.htaccess
wp-admin/
wp-includes/
wp-content/uploads
wp-content/themes/twentyfifteen
wp-content/themes/twentysixteen
wp-content/themes/twentyseventeen
.DS_Store
.idea

readme.html

node_modules

wp-content/plugins

cache
.tmb
.wpe-devkit
.wpengine-conf

# Local tooling repo (avoid accidental nested repo gitlink)
ameba-deploy/

# Runtime/cache/log artifacts (WordPress/local env)
wp-content/.logs/
wp-content/wflogs/
wp-content/temp/
wp-content/smush-webp/
wp-content/webp-express/log/

# Local DB artifacts created by sync tools
wp-content/mysql.sql

# WP Engine/local injected MU plugins (keep custom MU plugins trackable)
wp-content/mu-plugins/wpe-*.php
wp-content/mu-plugins/wpe-*/
wp-content/mu-plugins/wpengine-common/
wp-content/mu-plugins/wpengine-security-auditor.php
wp-content/mu-plugins/mu-plugin.php
wp-content/mu-plugins/force-strong-passwords/
wp-content/mu-plugins/slt-force-strong-passwords.php

# Plugin-generated local backups
wp-content/ai1wm-backups/

# Local maintenance SQL backups generated during prod2local pulls
ameba-maintenance/backups/local_pre_pull_*.sql

ameba-deploy-local-config/*
!ameba-deploy-local-config/.ameba-deploy.dev.env
!ameba-deploy-local-config/.ameba-deploy.stg.env
!ameba-deploy-local-config/.ameba-deploy.prod.env

ameba-deploy/*
!ameba-deploy-local-config/*.env
ameba-deploy-local-config/.ameba-deploy.local.env
ameba-deploy-local-config/.ameba-deploy.user.env

# Temporary DB dumps generated by deploy sync commands
ameba_dump_remote.sql

# Local/private sync artifacts and logs
.git-ftp.log
.maintenance
_wpeprivate/
ameba-maintenance/cli-update-*.log

# Temporary upgrade extractions and bundled zips
wp-content/upgrade/
wp-content/themes/x/framework/cornerstone.zip
